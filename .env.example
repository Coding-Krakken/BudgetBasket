# Database - Required
# For local dev: postgresql://postgres:password@localhost:5432/cartwise
# For Docker: postgresql://postgres:password@db:5432/cartwise
# For Vercel: Use Vercel Postgres or Neon connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/cartwise"

# Application
NEXT_PUBLIC_APP_NAME="CartWise AI"
NODE_ENV="development"

# AI/LLM - Optional. MVP works without this using deterministic normalization.
# OPTIONAL_OPENAI_API_KEY=""

# Retailer APIs - Optional. MVP uses seed providers without these.
# OPTIONAL_KROGER_CLIENT_ID=""
# OPTIONAL_KROGER_CLIENT_SECRET=""
# OPTIONAL_WALMART_CLIENT_ID=""
# OPTIONAL_WALMART_CLIENT_SECRET=""
# OPTIONAL_TARGET_CLIENT_ID=""
# OPTIONAL_TARGET_CLIENT_SECRET=""

# Coupon/Rebate Networks - Optional
# OPTIONAL_IBOTTA_API_KEY=""
# OPTIONAL_FLIPP_API_KEY=""
# OPTIONAL_COUPONS_API_KEY=""

# Security
# JWT_SECRET="your-secret-here-change-in-production"
# NEXTAUTH_SECRET="your-nextauth-secret"
# NEXTAUTH_URL="http://localhost:3000"
CRON_SECRET="change-me-before-production"
PROVIDER_SYNC_SECRET="change-me-before-production"
