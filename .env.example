# ─── Database ────────────────────────────────────────────────────────────────
# Required. For local dev: postgresql://postgres:password@localhost:5432/budgetbasket
DATABASE_URL="postgresql://postgres:password@localhost:5432/budgetbasket"

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="BudgetBasket"
NODE_ENV="development"
CRON_SECRET="change-me-before-production"
PROVIDER_SYNC_SECRET="change-me-before-production"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-nextauth-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ─── AI / LLM (optional) ─────────────────────────────────────────────────────
# OPTIONAL_OPENAI_API_KEY=""

# ═══════════════════════════════════════════════════════════════════════════════
# LIVE DATA PROVIDER CREDENTIALS
# All providers below are optional — missing credentials cause providers to
# report OFFLINE status with setup instructions rather than crashing.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Public / open-data providers (no credentials needed) ─────────────────────
# live-open-food-facts: https://world.openfoodfacts.org  (no key)
# live-usda:            https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY="DEMO_KEY"
# live-flipp:           https://backflipp.wishabi.com    (no key)
# live-walmart-deals:   scraper                          (no key)
# live-target-deals:    scraper                          (no key)
# live-costco:          scraper                          (no key)
# live-aldi:            scraper                          (no key)
# live-dollar-general:  scraper                          (no key)
# live-sams-club:       scraper                          (no key)
# live-flashfood:       https://www.flashfood.com        (try public, or key below)
# FLASHFOOD_API_KEY=""
# live-lozo:            https://www.lozo.com             (try public)
# live-slickdeals:      RSS                              (no key)
# live-hip2save:        RSS                              (no key)
# live-kcl:             RSS                              (no key)
# live-southern-savers: RSS                              (no key)
# live-reddit-deals:    JSON API                         (no key)

